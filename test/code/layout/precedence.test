<?php
$x = $a ? $b : $c;
$y = -$a;
-----
$stmts[1]->expr->expr->cond = new Expr\Assign(new Expr\Variable('d'), new Expr\Variable('e'));
$stmts[3]->expr->expr->expr = new Expr\BinaryOp\Plus(new Expr\Variable('b'), new Expr\Variable('c'));
-----
<?php
$x = ($d = $e) ? $b : $c;
$y = -($b + $c);
